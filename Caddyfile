# Railpack serves this folder with Caddy and uses this file instead of its
# default. It is Railpack's default Caddyfile with one change: script-src
# allows 'unsafe-eval', because support.js builds every page section with
# new Function(). Without it the browser blocks rendering.
{
	admin off
	persist_config off
	auto_https off

	log {
		format json
	}

	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT:80} {
	log {
		format json
	}

	respond /health 200

	# Security headers
	header {
		X-XSS-Protection "1; mode=block"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: https: *; style-src 'self' 'unsafe-inline' https: *; script-src 'self' 'unsafe-inline' 'unsafe-eval' https: *; font-src 'self' data: https: *; connect-src 'self' https: *; media-src 'self' https: *; object-src 'none'; frame-src 'self' https: *;"
		-Server
	}

	# The settings panel edits the live site and holds a GitHub token, so it is
	# not for the public. The password is asked for before anything under
	# /admin is served, so the page itself never reaches a stranger's browser.
	# Only the bcrypt hash of the password lives here; it cannot be read back.
	# To change the password, replace the hash with a new one from
	# `caddy hash-password`.
	basic_auth /admin* {
		konnex $2b$12$gCq01n2kEQwOqBa5wGmA/OkMHC2MrqHL3ZLEjuHlvlRSxL11B9w1y
	}

	root * {{.StaticFileRoot}}

	file_server {
		hide .git
		hide .env*
	}

	encode {
		gzip
		zstd
	}

	try_files {path} {path}.html {path}/index.html{{if .IndexFallback}} /index.html{{end}}

	handle_errors {
		rewrite * /{err.status_code}.html
		file_server
	}
}
